# ========================================================
# QL_CuaHangTienLoi - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR .env FILE TO GIT
# ========================================================

# Application Environment
NODE_ENV=development

# Service Ports (Host Machine)
GATEWAY_PORT=3000
IDENTITY_PORT=3001
PRODUCT_INVENTORY_PORT=3002
PURCHASE_PORT=3003
SALES_PORT=3004
CUSTOMER_LOYALTY_PORT=3005
HR_PORT=3006
INVENTORY_LOSS_PORT=3007
WEB_PORT=5173

# Microsoft SQL Server (Shared DB Phase 1)
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Password123
DB_NAME=QL_CuaHangTienLoi
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_CONNECTION_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# Redis (Cache, Distributed Locks, Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# RabbitMQ (Event Bus & Asynchronous Messaging)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=ql.events
RABBITMQ_DEAD_LETTER_EXCHANGE=ql.events.dlx

# Authentication & Security
JWT_SECRET=super-secret-development-key-please-replace-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-please-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d

# API Gateway Downstream URLs (Internal / Host)
IDENTITY_SERVICE_URL=http://localhost:3001
PRODUCT_INVENTORY_SERVICE_URL=http://localhost:3002
PURCHASE_SERVICE_URL=http://localhost:3003
SALES_SERVICE_URL=http://localhost:3004
CUSTOMER_LOYALTY_SERVICE_URL=http://localhost:3005
HR_SERVICE_URL=http://localhost:3006
INVENTORY_LOSS_SERVICE_URL=http://localhost:3007

# Frontend Public API Base URL
VITE_API_URL=http://localhost:3000/api

