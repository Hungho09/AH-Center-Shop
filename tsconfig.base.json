{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@ql/common": ["libs/common/src"],
      "@ql/common/*": ["libs/common/src/*"],
      "@ql/contracts": ["libs/contracts/src"],
      "@ql/contracts/*": ["libs/contracts/src/*"],
      "@ql/config": ["libs/config/src"],
      "@ql/config/*": ["libs/config/src/*"],
      "@ql/logger": ["libs/logger/src"],
      "@ql/logger/*": ["libs/logger/src/*"],
      "@ql/exceptions": ["libs/exceptions/src"],
      "@ql/exceptions/*": ["libs/exceptions/src/*"],
      "@ql/messaging": ["libs/messaging/src"],
      "@ql/messaging/*": ["libs/messaging/src/*"],
      "@ql/database": ["libs/database/src"],
      "@ql/database/*": ["libs/database/src/*"]
    }
  }
}

